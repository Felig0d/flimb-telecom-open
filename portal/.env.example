# Keep live integration disabled by default in the public repository.
FTI_API_ENABLED=false

# Configure only in private/local deployment.
FTI_API_BASE_URL=https://fti-api.example.invalid
FTI_API_TOKEN=
FTI_API_TIMEOUT_MS=2500

# Optional path mapping. This keeps the portal decoupled from private route names.
FTI_API_OVERVIEW_PATH=/api/overview
FTI_API_CALLS_PATH=/api/calls
FTI_API_RA_PATH=/api/revenue-assurance
