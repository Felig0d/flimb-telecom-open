# API reads: point at analytics read replica when available.
ANALYTICS_DATABASE_URL=postgresql://analytics_reader:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5433/analytics

# Consumer writes: point at authoritative analytics projection DB.
ANALYTICS_WRITE_DATABASE_URL=postgresql://analytics_app:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/analytics

ANALYTICS_API_HOST=127.0.0.1
ANALYTICS_API_PORT=8086
ANALYTICS_MAX_PAGE_SIZE=500

NATS_URL=nats://127.0.0.1:4222
NATS_CDR_SUBJECT=telecom.cdr.closed.v1
NATS_CDR_DURABLE=odin-analytics-cdr-v1
